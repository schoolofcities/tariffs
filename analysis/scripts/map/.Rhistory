cat("\nExcluded HS codes:", nrow(excluded_codes), "\n")
## -----------------------------------------------------------------
## Section 338 groupings
## Tariffed = Alcohol/Dairy/Motor minus carve-outs
## Total = Tariffed + Excluded  (this IS the full Section 338 universe)
## -----------------------------------------------------------------
tariffed_codes <- combined_df %>%
filter(Category %in% tariff_types) %>%
distinct(`HS Code`) %>%
anti_join(excluded_codes, by = "HS Code") %>%
mutate(Category = "Section 338 - Tariffed")
total_codes <- bind_rows(
tariffed_codes %>% select(`HS Code`),
excluded_codes %>% select(`HS Code`)
) %>%
distinct(`HS Code`) %>%
mutate(Category = "Section 338 - Total")
cat("Tariffed HS codes (excl. carve-outs):", nrow(tariffed_codes), "\n")
cat("Total HS codes:", nrow(total_codes), "\n")
stopifnot(nrow(total_codes) == nrow(tariffed_codes) + nrow(excluded_codes))
## -----------------------------------------------------------------
## before / after -- built EXCLUDING Section 338 types entirely,
## then "after" adds back the Section 338 - Total universe.
## -----------------------------------------------------------------
before_sep29 <- existing_clean %>%
filter(!(Category %in% tariff_types)) %>%
select(`HS Code`) %>%
distinct() %>%
mutate(Category = "before September 29")
after_non338 <- combined_df %>%
filter(!(Category %in% tariff_types)) %>%
select(`HS Code`) %>%
distinct()
after_sep29 <- bind_rows(after_non338, total_codes %>% select(`HS Code`)) %>%
distinct() %>%
mutate(Category = "after September 29")
cat("\n'before September 29' (non-Section-338 only):", nrow(before_sep29), "\n")
cat("'after September 29' (non-Section-338 + Section 338 Total):", nrow(after_sep29), "\n")
## -----------------------------------------------------------------
## Combine, drop legacy "Section 338", rename "August 22" labels,
## final dedup
## -----------------------------------------------------------------
final_df <- bind_rows(
combined_df,
before_sep29,
after_sep29,
tariffed_codes,
excluded_codes,
total_codes
) %>%
filter(!is.na(`HS Code`) & `HS Code` != "") %>%
filter(Category != "Section 338") %>%
mutate(Category = str_replace_all(Category, "August 22", "September 29")) %>%
distinct(`HS Code`, Category, .keep_all = TRUE)
dupe_check <- final_df %>%
group_by(Category, `HS Code`) %>%
filter(n() > 1)
cat("\nRemaining dupes after final dedup (should be 0):", nrow(dupe_check), "\n")
# sanity check: before should have zero Alcohol/Dairy/Motor codes
before_check <- final_df %>%
filter(Category == "before September 29") %>%
semi_join(combined_df %>% filter(Category %in% tariff_types), by = "HS Code")
cat("Section 338 codes leaking into 'before' (should be 0):", nrow(before_check), "\n")
# sanity check: after should equal after_non338 union Section 338 Total exactly
stopifnot(setequal(
final_df %>% filter(Category == "after September 29") %>% pull(`HS Code`),
union(after_non338$`HS Code`, total_codes$`HS Code`)
))
write.csv(final_df, output_path, row.names = FALSE)
cat("\n=== Summary ===\n")
cat("Rows added:", nrow(to_add), "\n")
cat("Rows deleted:", nrow(to_delete), "\n")
cat("'before September 29' rows:", nrow(before_sep29), "\n")
cat("'after September 29' rows:", nrow(after_sep29), "\n")
cat("'Section 338 - Tariffed' rows:", nrow(tariffed_codes), "\n")
cat("'Section 338 - Excluded' rows:", nrow(excluded_codes), "\n")
cat("'Section 338 - Total' rows:", nrow(total_codes), "\n")
cat("Total rows in final file:", nrow(final_df), "\n")
print(unique(final_df$Category))
unique(before_sep29$`Category`)
test <- existing_clean %>%
filter(!(Category %in% tariff_types))
test
unique(test$Category)
library(dplyr)
library(tidyverse)
library(readxl)
library(openxlsx)
library(stringr)
existing    <- read.csv("../../raw/tariffs/tariff_hs_codes_8_27_2026.csv", stringsAsFactors = FALSE)
new_path    <- "../../raw/tariffs/effec_sep_29.xlsx"
output_path <- "../../raw/tariffs/tariff_hs_codes_9_29_2026.csv"
if ("HS.Code" %in% colnames(existing)) {
colnames(existing)[colnames(existing) == "HS.Code"] <- "HS Code"
}
existing <- existing %>%
mutate(`HS Code` = as.character(`HS Code`))
## -----------------------------------------------------------------
## Purge stale rollup categories from a prior run FIRST, before
## anything else touches the data. These are always regenerated
## fresh -- they must never be treated as pass-through categories.
## -----------------------------------------------------------------
legacy_rollup_cats <- c("before August 22", "after August 22", "Section 338")
existing_clean <- existing %>%
filter(!(Category %in% legacy_rollup_cats)) %>%
distinct(`HS Code`, Category, .keep_all = TRUE)
cat("Rows after dedup + legacy rollup purge:", nrow(existing_clean), "\n")
cat("Rows removed (dupes + legacy rollups):", nrow(existing) - nrow(existing_clean), "\n")
## -----------------------------------------------------------------
## Sheet: addremove  (Add / Delete / Type)
## -----------------------------------------------------------------
changes <- read_excel(new_path, sheet = "addremove") %>%
mutate(
Add    = as.character(Add),
Delete = as.character(Delete),
Type   = str_to_title(Type)
)
to_add <- changes %>%
filter(!is.na(Add)) %>%
transmute(`HS Code` = Add, Category = Type)
to_delete <- changes %>%
filter(!is.na(Delete)) %>%
transmute(`HS Code` = Delete, Category = Type)
cat("\nRows to add:", nrow(to_add), "\n")
cat("Rows to delete:", nrow(to_delete), "\n")
combined_df <- existing_clean %>%
anti_join(to_delete, by = c("HS Code", "Category")) %>%
bind_rows(to_add) %>%
filter(!is.na(`HS Code`) & `HS Code` != "") %>%
distinct(`HS Code`, Category, .keep_all = TRUE)
## Section 338 types -- Auto is NOT part of Section 338
tariff_types <- c("Alcohol", "Dairy", "Motor")
## -----------------------------------------------------------------
## Sheet: excluded  (Excluded / Type) -> one combined category
## -----------------------------------------------------------------
excluded_raw <- read_excel(new_path, sheet = "excluded") %>%
mutate(Excluded = as.character(Excluded))
excluded_codes <- excluded_raw %>%
filter(!is.na(Excluded)) %>%
distinct(`HS Code` = Excluded) %>%
mutate(Category = "Section 338 - Excluded")
cat("\nExcluded HS codes:", nrow(excluded_codes), "\n")
## -----------------------------------------------------------------
## Section 338 groupings
## Tariffed = Alcohol/Dairy/Motor minus carve-outs
## Total = Tariffed + Excluded  (the full Section 338 universe)
## -----------------------------------------------------------------
tariffed_codes <- combined_df %>%
filter(Category %in% tariff_types) %>%
distinct(`HS Code`) %>%
anti_join(excluded_codes, by = "HS Code") %>%
mutate(Category = "Section 338 - Tariffed")
total_codes <- bind_rows(
tariffed_codes %>% select(`HS Code`),
excluded_codes %>% select(`HS Code`)
) %>%
distinct(`HS Code`) %>%
mutate(Category = "Section 338 - Total")
cat("Tariffed HS codes (excl. carve-outs):", nrow(tariffed_codes), "\n")
cat("Total HS codes:", nrow(total_codes), "\n")
stopifnot(nrow(total_codes) == nrow(tariffed_codes) + nrow(excluded_codes))
## -----------------------------------------------------------------
## before / after -- built EXCLUDING Section 338 types entirely
## (existing_clean/combined_df are already free of the legacy rollup
## labels from the purge step above). "after" adds back
## Section 338 - Total to fully reconstruct the current universe.
## -----------------------------------------------------------------
before_sep29 <- existing_clean %>%
filter(!(Category %in% tariff_types)) %>%
select(`HS Code`) %>%
distinct() %>%
mutate(Category = "before September 29")
after_non338 <- combined_df %>%
filter(!(Category %in% tariff_types)) %>%
select(`HS Code`) %>%
distinct()
after_sep29 <- bind_rows(after_non338, total_codes %>% select(`HS Code`)) %>%
distinct() %>%
mutate(Category = "after September 29")
cat("\n'before September 29' (non-Section-338 only):", nrow(before_sep29), "\n")
cat("'after September 29' (non-Section-338 + Section 338 Total):", nrow(after_sep29), "\n")
## -----------------------------------------------------------------
## Combine, rename "August 22" labels (any that remain), final dedup
## -----------------------------------------------------------------
final_df <- bind_rows(
combined_df,
before_sep29,
after_sep29,
tariffed_codes,
excluded_codes,
total_codes
) %>%
filter(!is.na(`HS Code`) & `HS Code` != "") %>%
filter(!(Category %in% legacy_rollup_cats)) %>%   # belt-and-suspenders
mutate(Category = str_replace_all(Category, "August 22", "September 29")) %>%
distinct(`HS Code`, Category, .keep_all = TRUE)
dupe_check <- final_df %>%
group_by(Category, `HS Code`) %>%
filter(n() > 1)
cat("\nRemaining dupes after final dedup (should be 0):", nrow(dupe_check), "\n")
# sanity: before should have zero Alcohol/Dairy/Motor codes
before_leak <- final_df %>%
filter(Category == "before September 29") %>%
semi_join(combined_df %>% filter(Category %in% tariff_types), by = "HS Code")
cat("Section 338 codes leaking into 'before' (should be 0):", nrow(before_leak), "\n")
# sanity: no legacy rollup labels survived
cat("Legacy rollup categories remaining (should be 0 rows):",
nrow(final_df %>% filter(Category %in% legacy_rollup_cats)), "\n")
# sanity: after == after_non338 union Section 338 Total exactly
stopifnot(setequal(
final_df %>% filter(Category == "after September 29") %>% pull(`HS Code`),
union(after_non338$`HS Code`, total_codes$`HS Code`)
))
write.csv(final_df, output_path, row.names = FALSE)
cat("\n=== Summary ===\n")
cat("Rows added:", nrow(to_add), "\n")
cat("Rows deleted:", nrow(to_delete), "\n")
cat("'before September 29' rows:", nrow(before_sep29), "\n")
cat("'after September 29' rows:", nrow(after_sep29), "\n")
cat("'Section 338 - Tariffed' rows:", nrow(tariffed_codes), "\n")
cat("'Section 338 - Excluded' rows:", nrow(excluded_codes), "\n")
cat("'Section 338 - Total' rows:", nrow(total_codes), "\n")
cat("Total rows in final file:", nrow(final_df), "\n")
print(unique(final_df$Category))
library(dplyr)
library(tidyverse)
library(readxl)
library(openxlsx)
library(stringr)
existing_path <- "../../raw/tariffs/tariff-hscodes_noderiv.csv"
new_path      <- "../../raw/tariffs/section_338.xlsx"
output_path   <- "../../raw/tariffs/tariff_hs_codes_9_29_2026_clean.csv"
existing <- read.csv(existing_path, stringsAsFactors = FALSE)
if ("HS.Code" %in% colnames(existing)) {
colnames(existing)[colnames(existing) == "HS.Code"] <- "HS Code"
}
existing <- existing %>%
mutate(`HS Code` = as.character(`HS Code`))
## -----------------------------------------------------------------
## Purge any Section 338 / before-after rollup categories up front,
## in case this input ever already has them baked in. Defensive --
## tariff-hscodes_noderiv.csv shouldn't contain any of this, but we
## never want stale rollups silently surviving into the new file.
## -----------------------------------------------------------------
legacy_rollup_cats <- c(
"before August 22", "after August 22", "Section 338",
"before September 29", "after September 29",
"Section 338 - Tariffed", "Section 338 - Excluded", "Section 338 - Total",
"Alcohol", "Dairy", "Motor"
)
existing_clean <- existing %>%
filter(!(Category %in% legacy_rollup_cats)) %>%
distinct(`HS Code`, Category, .keep_all = TRUE)
cat("Rows in noderiv file:", nrow(existing), "\n")
cat("Rows after purge + dedup (should equal input if truly clean):", nrow(existing_clean), "\n")
## -----------------------------------------------------------------
## Read section_338.xlsx -- one sheet per type/base/addition/exclusion
## Expected sheets: <type>, <type> sep 29, <type> sep 29 excl
## (the "sep 29" addition sheet is optional -- e.g. dairy has none)
## -----------------------------------------------------------------
sheet_names <- excel_sheets(new_path)
types <- c("alcohol", "dairy", "motor")
read_col <- function(sheet) {
if (!(sheet %in% sheet_names)) return(character(0))
vals <- read_excel(new_path, sheet = sheet, col_names = FALSE)[[1]]
vals <- as.character(vals)
vals[!is.na(vals) & vals != ""]
}
type_df_list <- list()
excluded_list <- list()
for (t in types) {
base_codes  <- read_col(t)
add_codes   <- read_col(paste(t, "sep 29"))
excl_codes  <- read_col(paste(t, "sep 29 excl"))
cat("\n[", t, "] base:", length(base_codes),
" sep29 adds:", length(add_codes),
" sep29 excl:", length(excl_codes), "\n")
type_df_list[[t]] <- data.frame(
`HS Code` = unique(c(base_codes, add_codes)),
Category = str_to_title(t),
stringsAsFactors = FALSE,
check.names = FALSE
)
if (length(excl_codes) > 0) {
excluded_list[[t]] <- data.frame(`HS Code` = excl_codes, stringsAsFactors = FALSE, check.names = FALSE)
}
}
type_df <- bind_rows(type_df_list) %>%
distinct(`HS Code`, Category, .keep_all = TRUE)
excluded_codes <- bind_rows(excluded_list) %>%
distinct(`HS Code`) %>%
mutate(Category = "Section 338 - Excluded")
cat("\nTotal Alcohol/Dairy/Motor rows (base+adds, deduped):", nrow(type_df), "\n")
cat("Total excluded HS codes (combined across types):", nrow(excluded_codes), "\n")
## Section 338 types -- Auto is NOT part of Section 338
tariff_types <- c("Alcohol", "Dairy", "Motor")
## -----------------------------------------------------------------
## Section 338 groupings
## Tariffed = Alcohol/Dairy/Motor minus carve-outs
## Total = Tariffed + Excluded  (the full Section 338 universe)
## -----------------------------------------------------------------
tariffed_codes <- type_df %>%
filter(Category %in% tariff_types) %>%
distinct(`HS Code`) %>%
anti_join(excluded_codes, by = "HS Code") %>%
mutate(Category = "Section 338 - Tariffed")
total_codes <- bind_rows(
tariffed_codes %>% select(`HS Code`),
excluded_codes %>% select(`HS Code`)
) %>%
distinct(`HS Code`) %>%
mutate(Category = "Section 338 - Total")
cat("Tariffed HS codes (excl. carve-outs):", nrow(tariffed_codes), "\n")
cat("Total HS codes:", nrow(total_codes), "\n")
stopifnot(nrow(total_codes) == nrow(tariffed_codes) + nrow(excluded_codes))
## -----------------------------------------------------------------
## before / after -- built from the non-Section-338 base (noderiv
## file) only. "after" adds back Section 338 - Total.
## -----------------------------------------------------------------
before_sep29 <- existing_clean %>%
select(`HS Code`) %>%
distinct() %>%
mutate(Category = "before September 29")
after_sep29 <- bind_rows(
existing_clean %>% select(`HS Code`),
total_codes %>% select(`HS Code`)
) %>%
distinct() %>%
mutate(Category = "after September 29")
cat("\n'before September 29' (non-Section-338 only):", nrow(before_sep29), "\n")
cat("'after September 29' (non-Section-338 + Section 338 Total):", nrow(after_sep29), "\n")
## -----------------------------------------------------------------
## Combine everything, final dedup
## -----------------------------------------------------------------
final_df <- bind_rows(
existing_clean,     # Auto, Steel, Aluminum, Copper, Energy Mineral, MHDV, Lumber (new/old)
type_df,            # Alcohol, Dairy, Motor (base + this round's adds)
before_sep29,
after_sep29,
tariffed_codes,
excluded_codes,
total_codes
) %>%
filter(!is.na(`HS Code`) & `HS Code` != "") %>%
distinct(`HS Code`, Category, .keep_all = TRUE)
dupe_check <- final_df %>%
group_by(Category, `HS Code`) %>%
filter(n() > 1)
cat("\nRemaining dupes after final dedup (should be 0):", nrow(dupe_check), "\n")
# sanity: before should have zero Alcohol/Dairy/Motor codes
before_leak <- final_df %>%
filter(Category == "before September 29") %>%
semi_join(type_df, by = "HS Code")
cat("Section 338 codes leaking into 'before' (should be 0):", nrow(before_leak), "\n")
# sanity: after == existing_clean union Section 338 Total exactly
stopifnot(setequal(
final_df %>% filter(Category == "after September 29") %>% pull(`HS Code`),
union(existing_clean$`HS Code`, total_codes$`HS Code`)
))
write.csv(final_df, output_path, row.names = FALSE)
cat("\n=== Summary ===\n")
cat("'before September 29' rows:", nrow(before_sep29), "\n")
cat("'after September 29' rows:", nrow(after_sep29), "\n")
cat("'Section 338 - Tariffed' rows:", nrow(tariffed_codes), "\n")
cat("'Section 338 - Excluded' rows:", nrow(excluded_codes), "\n")
cat("'Section 338 - Total' rows:", nrow(total_codes), "\n")
cat("Total rows in final file:", nrow(final_df), "\n")
print(unique(final_df$Category))
