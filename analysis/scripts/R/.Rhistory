LONGITUDE = mean(LONGITUDE, na.rm = TRUE), .groups = "drop") %>%
rename(lat_fsa = LATITUDE, long_fsa = LONGITUDE)   # ← rename here
map_geocoded_all <- map_df_all %>%
left_join(geocode, by = c("ZIPP4F" = "POSTAL_CODE")) %>%
rename(lat = LATITUDE, long = LONGITUDE) %>%
mutate(ZIPP4F_len = nchar(ZIPP4F)) %>%
mutate(FSA = substr(ZIPP4F, 1, 3)) %>%
left_join(geocode_fsa, by = "FSA") %>%
mutate(
lat  = coalesce(lat, lat_fsa),
long = coalesce(long, long_fsa),
geocode_precision = case_when(
!is.na(lat) & ZIPP4F_len == 6 ~ "full_postal",
!is.na(lat) ~ "fsa_only",
TRUE ~ "unmatched"
)
) %>%
select(-lat_fsa, -long_fsa, -ZIPP4F_len)
# map_geocoded_all <- map_df_all %>%
#   left_join(geocode, by = c("ZIPP4F" = "POSTAL_CODE")) %>%
#   rename(lat = LATITUDE, long = LONGITUDE)
write.csv(map_geocoded_all, "map_geocoded_all.csv", row.names = FALSE)
cat("Total firms:", nrow(map_geocoded_all), "\n")
cat("Matched with coords:", sum(!is.na(map_geocoded_all$lat)), "\n")
cat("Match rate:", round(mean(!is.na(map_geocoded_all$lat)) * 100, 1), "%\n")
map_geocoded_all <- read.csv("map_geocoded_all.csv") %>%
filter(!is.na(lat), !is.na(long)) %>%
mutate(
sales_M     = sales_000 / 1000,
naics_label = NAICSD,
short_label = paste0(NAICS6, ": ", substr(NAICSD, 1, 28)),
year_group  = as.character(year)
)
map_cols <- c(
"CONAME", "lat", "long", "NAICS6", "NAICSD",
"sales_M", "employees", "PUBPRV", "HDBRCH", "is_hq",
"STATE", "STCITY", "year"
)
map_export <- map_geocoded_all %>%
select(all_of(map_cols)) %>%
filter(!is.na(lat), !is.na(long))
write.csv(map_export, "map_export.csv", row.names = FALSE)
all_years %>%
filter(NAICS6 %in% defence_naics) %>%
count(NAICS6, NAICSD) %>%
arrange(NAICS6)
# Full year x code grid so missing years show up explicitly
full_grid <- expand_grid(
year   = years,
NAICS6 = defence_naics_6digit
)
presence <- all_years %>%
filter(NAICS6 %in% defence_naics_6digit) %>%
count(year, NAICS6, name = "n_firms")
presence_full <- full_grid %>%
left_join(presence, by = c("year", "NAICS6")) %>%
mutate(
n_firms = replace_na(n_firms, 0),
present = n_firms > 0
)
# Wide table: rows = codes, columns = years, values = firm count
presence_wide <- presence_full %>%
select(year, NAICS6, n_firms) %>%
pivot_wider(names_from = year, values_from = n_firms, values_fill = 0)
write.csv(presence_wide, "naics_presence_by_year.csv", row.names = FALSE)
print(presence_wide, n = Inf)
# Flag codes that disappear after having been present in an earlier year
disappearing <- presence_full %>%
group_by(NAICS6) %>%
arrange(year) %>%
mutate(was_present_before = cumsum(present) > 0 & !present) %>%
filter(was_present_before) %>%
distinct(NAICS6, year)
if (nrow(disappearing) > 0) {
cat("Codes that disappear in a later year after being present earlier:\n")
print(disappearing)
} else {
cat("No codes disappear once they first appear.\n")
}
# Flag codes that never appear in any year at all
never_present <- presence_full %>%
group_by(NAICS6) %>%
summarise(total_firms = sum(n_firms), .groups = "drop") %>%
filter(total_firms == 0)
if (nrow(never_present) > 0) {
cat("\nCodes with zero firms across all years:\n")
print(never_present)
}
# Visual: presence heatmap across years
ggplot(presence_full, aes(x = factor(year), y = NAICS6, fill = present)) +
geom_tile(color = "white") +
scale_fill_manual(values = c("TRUE" = "#2a9d8f", "FALSE" = "#e76f51"),
labels = c("TRUE" = "Present", "FALSE" = "Missing")) +
labs(title = "Defence NAICS Code Presence by Year",
x = "Year", y = "NAICS6", fill = NULL) +
theme_minimal(base_size = 10)
# Diagnostic: where are firms getting dropped?
cat("all_years total:", nrow(all_years), "\n")
cat("map_df_all (after sales_000/ZIPP4F NA drop):", nrow(map_df_all), "\n")
cat("map_geocoded_all (after geocode join):", nrow(map_geocoded_all), "\n")
cat("map_export (after lat/long filter):", nrow(map_export), "\n")
cat("\nDropped by missing sales_000 or ZIPP4F:", nrow(all_years) - nrow(map_df_all), "\n")
cat("Dropped by failed geocode match:", sum(is.na(map_geocoded_all$lat)), "\n")
# Per-year breakdown
all_years %>%
count(year) %>%
rename(all_years_n = n) %>%
left_join(map_export %>% count(year) %>% rename(map_export_n = n), by = "year") %>%
mutate(
dropped = all_years_n - map_export_n,
pct_dropped = round(dropped / all_years_n * 100, 1)
)
# Check a sample of unmatched postal codes vs the lookup table's format
unmatched <- map_df_all %>%
anti_join(geocode, by = c("ZIPP4F" = "POSTAL_CODE")) %>%
distinct(ZIPP4F) %>%
head(30)
print(unmatched)
# Compare to what's actually in geocode
geocode %>% distinct(POSTAL_CODE) %>% head(10)
geocode %>% count(POSTAL_CODE) %>% filter(n > 1) %>% nrow()
cat("map_df_all rows:", nrow(map_df_all), "\n")
cat("map_geocoded_all rows:", nrow(map_geocoded_all), "\n")
map_geocoded_all %>% count(geocode_precision)
cat("map_export rows:", nrow(map_export), "\n")
