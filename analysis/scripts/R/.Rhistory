cat("map_export (after lat/long filter):", nrow(map_export), "\n")
cat("\nDropped by missing sales_000 or ZIPP4F:", nrow(all_years) - nrow(map_df_all), "\n")
cat("Dropped by failed geocode match:", sum(is.na(map_geocoded_all$lat)), "\n")
# Per-year breakdown
all_years %>%
count(year) %>%
rename(all_years_n = n) %>%
left_join(map_export %>% count(year) %>% rename(map_export_n = n), by = "year") %>%
mutate(
dropped = all_years_n - map_export_n,
pct_dropped = round(dropped / all_years_n * 100, 1)
)
