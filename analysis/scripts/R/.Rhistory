all_years %>%
filter(NAICS6 %in% defence_naics) %>%
count(NAICS6, NAICSD) %>%
arrange(NAICS6)
# Full year x code grid so missing years show up explicitly
full_grid <- expand_grid(
year   = years,
NAICS6 = defence_naics_6digit
)
presence <- all_years %>%
filter(NAICS6 %in% defence_naics_6digit) %>%
count(year, NAICS6, name = "n_firms")
presence_full <- full_grid %>%
left_join(presence, by = c("year", "NAICS6")) %>%
mutate(
n_firms = replace_na(n_firms, 0),
present = n_firms > 0
)
# Wide table: rows = codes, columns = years, values = firm count
presence_wide <- presence_full %>%
select(year, NAICS6, n_firms) %>%
pivot_wider(names_from = year, values_from = n_firms, values_fill = 0)
write.csv(presence_wide, "naics_presence_by_year.csv", row.names = FALSE)
print(presence_wide, n = Inf)
# Flag codes that disappear after having been present in an earlier year
disappearing <- presence_full %>%
group_by(NAICS6) %>%
arrange(year) %>%
mutate(was_present_before = cumsum(present) > 0 & !present) %>%
filter(was_present_before) %>%
distinct(NAICS6, year)
if (nrow(disappearing) > 0) {
cat("Codes that disappear in a later year after being present earlier:\n")
print(disappearing)
} else {
cat("No codes disappear once they first appear.\n")
}
# Flag codes that never appear in any year at all
never_present <- presence_full %>%
group_by(NAICS6) %>%
summarise(total_firms = sum(n_firms), .groups = "drop") %>%
filter(total_firms == 0)
if (nrow(never_present) > 0) {
cat("\nCodes with zero firms across all years:\n")
print(never_present)
}
# Visual: presence heatmap across years
ggplot(presence_full, aes(x = factor(year), y = NAICS6, fill = present)) +
geom_tile(color = "white") +
scale_fill_manual(values = c("TRUE" = "#2a9d8f", "FALSE" = "#e76f51"),
labels = c("TRUE" = "Present", "FALSE" = "Missing")) +
labs(title = "Defence NAICS Code Presence by Year",
x = "Year", y = "NAICS6", fill = NULL) +
theme_minimal(base_size = 10)
