setwd("D:/coding/SoC/tariffs/tariffs/analysis/scripts/R")
library(dplyr)
library(openxlsx)
library(stringr)
# Inputs are the COMPLETE frames from the ADA/CSD notebooks:
#   centroids.*  -> counts   (_B / _E / _C)
#   choropleth.* -> percents (_1 / _2 / _3)
# Do NOT use counts_ada.csv / percents_ada.csv here: those are written from
# business_filter / choro_cols, which never contain the _C / _3 columns.
counts_ada   <- read.csv("../../outputs/csv/centroids.csv",       check.names = FALSE)
percents_ada <- read.csv("../../outputs/csv/choropleth.csv",      check.names = FALSE)
counts_csd   <- read.csv("../../outputs/csv/centroids_csd.csv",   check.names = FALSE)
percents_csd <- read.csv("../../outputs/csv/choropleth_csd.csv",  check.names = FALSE)
# Columns that are identifiers/geometry, not metrics -- left untouched.
ID_COLS <- c("ADADGUID", "CSDDGUID", "CMADGUID", "geometry",
"All_Businesses", "All_Employees", "Census")
# Suffix -> indicator name. Counts and percents use different suffix letters
# for the same three indicators, so both map onto one vocabulary.
SUFFIX_MAP <- c(
"1" = "Business",      "B" = "Business",
"2" = "EmployeeWork",  "E" = "EmployeeWork",
"3" = "EmployeeHome",  "C" = "EmployeeHome"
)
column_rename <- function(data) {
old <- colnames(data)
new <- vapply(old, function(nm) {
if (nm %in% ID_COLS) return(nm)
# split on the FINAL underscore only, so bases containing underscores
# (S338_Tar, S338_Exc, S338_Tot, Lumber (old), etc.) survive intact
m <- str_match(nm, "^(.*)_([123BEC])$")
if (is.na(m[1, 1])) return(nm)          # no recognised suffix; leave as-is
base   <- m[1, 2]
suffix <- m[1, 3]
paste0(base, "_", SUFFIX_MAP[[suffix]])
}, character(1), USE.NAMES = FALSE)
colnames(data) <- new
# Surface anything that didn't get mapped -- usually a sign a suffix is
# missing upstream (e.g. no _3 because the export came from choro_cols).
unmapped <- old[!(old %in% ID_COLS) & !str_detect(old, "_[123BEC]$")]
if (length(unmapped) > 0) {
message("  unmapped columns: ", paste(unmapped, collapse = ", "))
}
data
}
# Warn loudly if an indicator is missing entirely, rather than silently
# shipping a two-thirds-complete workbook.
check_indicators <- function(data, label) {
present <- unique(na.omit(
str_match(colnames(data), "_(Business|EmployeeWork|EmployeeHome)$")[, 2]
))
missing <- setdiff(c("Business", "EmployeeWork", "EmployeeHome"), present)
if (length(missing) > 0) {
warning(label, " is missing indicator(s): ", paste(missing, collapse = ", "),
call. = FALSE)
}
cat(label, "->", ncol(data), "cols, indicators:",
paste(sort(present), collapse = ", "), "\n")
}
counts_ada   <- column_rename(counts_ada)
percents_ada <- column_rename(percents_ada)
counts_csd   <- column_rename(counts_csd)
percents_csd <- column_rename(percents_csd)
check_indicators(counts_ada,   "counts_ada")
check_indicators(percents_ada, "percents_ada")
check_indicators(counts_csd,   "counts_csd")
check_indicators(percents_csd, "percents_csd")
# One workbook per geography, two sheets each -- matches what the CMA
# notebook expects (sheet_name='Counts' / 'Percents').
write.xlsx(
list(Counts = counts_ada, Percents = percents_ada),
file = "ada_counts_and_percents.xlsx",
overwrite = TRUE
)
write.xlsx(
list(Counts = counts_csd, Percents = percents_csd),
file = "csd_counts_and_percents.xlsx",
overwrite = TRUE
)
cat("\nWrote ada_counts_and_percents.xlsx and csd_counts_and_percents.xlsx\n")
