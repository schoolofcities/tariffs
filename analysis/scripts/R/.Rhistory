geocode <- read.csv("CanadianPostalCodes202403.csv") %>%
select(POSTAL_CODE, LATITUDE, LONGITUDE) %>%
mutate(POSTAL_CODE = str_remove_all(str_to_upper(POSTAL_CODE), " "))
map_df_all <- all_years %>%
filter(!is.na(sales_000), !is.na(ZIPP4F)) %>%
mutate(
sales_M     = sales_000 / 1000,
naics_label = NAICSD,
ZIPP4F      = str_remove_all(str_to_upper(ZIPP4F), " "),
is_hq       = HDBRCH == "HQ" | is.na(HDBRCH)   # ← flag instead of filter
)
geocode <- geocode %>%
group_by(POSTAL_CODE) %>%
summarise(LATITUDE = mean(LATITUDE, na.rm = TRUE),
LONGITUDE = mean(LONGITUDE, na.rm = TRUE), .groups = "drop")
geocode <- geocode %>%
distinct(POSTAL_CODE, .keep_all = TRUE)
geocode_fsa <- geocode %>%
mutate(FSA = substr(POSTAL_CODE, 1, 3)) %>%
group_by(FSA) %>%
summarise(LATITUDE = mean(LATITUDE, na.rm = TRUE),
LONGITUDE = mean(LONGITUDE, na.rm = TRUE), .groups = "drop") %>%
rename(lat_fsa = LATITUDE, long_fsa = LONGITUDE)   # ← rename here
map_geocoded_all <- map_df_all %>%
left_join(geocode, by = c("ZIPP4F" = "POSTAL_CODE")) %>%
rename(lat = LATITUDE, long = LONGITUDE) %>%
mutate(ZIPP4F_len = nchar(ZIPP4F)) %>%
mutate(FSA = substr(ZIPP4F, 1, 3)) %>%
left_join(geocode_fsa, by = "FSA") %>%
mutate(
lat  = coalesce(lat, lat_fsa),
long = coalesce(long, long_fsa),
geocode_precision = case_when(
!is.na(lat) & ZIPP4F_len == 6 ~ "full_postal",
!is.na(lat) ~ "fsa_only",
TRUE ~ "unmatched"
)
) %>%
select(-lat_fsa, -long_fsa, -ZIPP4F_len)
