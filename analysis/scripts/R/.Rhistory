years <- 2017:2025
#path <- "dafilter_1"
all_years <- map_dfr(years, function(yr) {
path <- paste0("da", substr(yr, 3, 4), "_filter.csv")
if (!file.exists(path)) {
message("Skipping missing file: ", path)
return(NULL)
}
read.csv(path, colClasses = "character") %>%
mutate(year = yr)
}) %>%
mutate(
sales_000 = as.numeric(sales_000),
employees = as.numeric(employees),
NAICS6    = as.character(NAICS6),
year      = as.integer(year)
)
colnames(all_years)
defence_summary <- all_years %>%
group_by(NAICS6, NAICSD, year) %>%
summarise(
n_firms         = n(),
total_sales_M   = sum(sales_000, na.rm = TRUE) / 1000,
avg_sales_M     = mean(sales_000, na.rm = TRUE) / 1000,
total_employees = sum(employees, na.rm = TRUE),
avg_employees   = mean(employees, na.rm = TRUE),
pct_headquarter = mean(HDBRCH == 1, na.rm = TRUE) * 100,
.groups = "drop"
) %>%
arrange(desc(total_sales_M))
write.csv(defence_summary, "defence_summary_all_years.csv", row.names = FALSE)
for (yr in 2017:2025) {
