# run_pipeline.R  --  one place to choose how industry (QCEW) data is handled.
# Run from analysis/scripts/R:   source("run_pipeline.R")
#
#   QCEW_MODE <- "skip"         no industry data, no BLS access. Runs everything else:
#                               daily series, window YoY, metro YoY, map, base table
#                               (population / border distance / airports), workbook.
#                               Correlations, scatter, regressions are left out.
#   QCEW_MODE <- "provisional"  industry shares from the legacy QCEW csv (no BLS needed).
#                               Biased shares; clearly labelled; NOT FOR PUBLICATION.
#   QCEW_MODE <- "bls"          the real thing: QCEW from BLS (API, or the zip you
#                               downloaded in a browser via QCEW_ZIP).
#
# Each mode writes to its own folder (suffix __NO_QCEW / __PROVISIONAL / none), so a
# skip or provisional run can never be mistaken for the final results.
QCEW_MODE   <- "skip"                                        # "skip" | "provisional" | "bls"
TRIPS_FILE  <- "../../raw/10_24/city_date_no_return.csv"
DENOMINATOR <- "ACTIVE_DEVICES"                              # or "ALL_DEVICES"
QCEW_CSV    <- "../../outputs/qcew_msa_industry_2023_a.csv"  # used by "provisional"
QCEW_ZIP    <- ""                                            # used by "bls", e.g. "../../raw/2023_annual_by_area.zip"
MAX_SUPPRESSED_SECTORS <- 5                                  # used by "provisional"
stopifnot(QCEW_MODE %in% c("skip", "provisional", "bls"))
run_params <- list(trips_file = TRIPS_FILE, denominator = DENOMINATOR)
run_params <- c(run_params, switch(QCEW_MODE,
skip        = list(use_qcew = FALSE),
provisional = list(use_qcew = TRUE, qcew_file = QCEW_CSV,
max_suppressed_sectors = MAX_SUPPRESSED_SECTORS, out_dir = "output_PROVISIONAL"),
bls         = list(use_qcew = TRUE, qcew_zip = QCEW_ZIP)))
message("Running in QCEW mode: ", QCEW_MODE)
# Fresh environment: a leftover `params` (or other objects) in your R session can't interfere.
rmarkdown::render("frontiers_pipeline.Rmd", params = run_params,
output_file = paste0("frontiers_pipeline_", QCEW_MODE, ".html"),
envir = new.env(parent = globalenv()))
